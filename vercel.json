{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/build.js",
  "outputDirectory": "prototipo",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/cafes",
      "destination": "/en/coffees",
      "permanent": true
    },
    {
      "source": "/en/subasta",
      "destination": "/en/auction",
      "permanent": true
    },
    {
      "source": "/en/suscripcion",
      "destination": "/en/subscription",
      "permanent": true
    },
    {
      "source": "/en/diario",
      "destination": "/en/journal",
      "permanent": true
    },
    {
      "source": "/en/cafe-(.*)",
      "destination": "/en/coffee-$1",
      "permanent": true
    },
    {
      "source": "/en/diario-(.*)",
      "destination": "/en/journal-$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
